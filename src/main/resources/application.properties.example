spring.application.name=FemFitAI

# Sustituye estos valores de ejemplo en tu application.properties local.
spring.datasource.url=jdbc:postgresql://localhost:5432/TU_BASE_DE_DATOS
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_PASSWORD

# update puede modificar el esquema al iniciar la aplicacion.
# Usa validate si solo deseas comprobar un esquema existente.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Reemplaza este marcador por un secreto aleatorio de al menos 64 caracteres.
# No subas el valor real a Git.
jwt.secret=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
